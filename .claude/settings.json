{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(make:*)",
      "Bash(cargo:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Read",
      "Write",
      "Edit",
      "WebSearch"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Read(.env*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Write(.env*)",
      "Write(pnpm-lock.yaml)",
      "Write(Cargo.lock)"
    ],
    "ask": [
      "Bash(pnpm add:*)",
      "Bash(cargo add:*)",
      "Bash(git merge:*)",
      "Bash(gh pr merge:*)",
      "WebFetch"
    ]
  },
  "env": {
    "RUST_BACKTRACE": "1"
  }
}
